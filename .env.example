# Copy to .env and fill in. Read by docker-compose.yml.

# Telemetry endpoint. The car connects here with mutual TLS.
TELEMETRY_PORT=443                 # another port if 443 is taken or blocked, e.g. 8443
TELEMETRY_NAMESPACE=tesla_telemetry

# Cars and Home Assistant MQTT
TGW_VINS=5YJ3XXXXXXXXXXXXX         # comma-separated for several cars
TGW_HA_BROKER=tcp://homeassistant.local:1883
TGW_HA_USERNAME=mqtt
TGW_HA_PASSWORD=changeme
TGW_UNITS_SYSTEM=metric            # metric | imperial

# Features
TGW_FLEETAPI_ENABLED=true          # true if you run TeslaMate
TGW_COMMANDS_ENABLED=true          # car commands; needs a token from the wizard

# Tesla app credentials from developer.tesla.com. The wizard saves the token.
TGW_TESLA_CLIENT_ID=
TGW_TESLA_CLIENT_SECRET=
TGW_TESLA_REFRESH_TOKEN=
TGW_TESLA_FLEET_API_URL=https://fleet-api.prd.na.vn.cloud.tesla.com   # Europe: fleet-api.prd.eu.vn.cloud.tesla.com
